# Copy to .env and fill in real values before running docker compose.
# docker compose fails fast if a required variable is missing.
#
# Generate strong values, e.g.:  openssl rand -base64 48

# PostgreSQL superuser password (also used by services and postgres-exporter)
POSTGRES_PASSWORD=

# Redis AUTH password (redis-server --requirepass, services, redis-exporter)
REDIS_PASSWORD=

# HMAC secret for JWT signing — minimum 32 bytes; services refuse to start otherwise
JWT_SECRET=

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional: bearer token Prometheus must send to scrape /metrics.
# Leave empty for open scrapes in dev; REQUIRED in production
# (ENVIRONMENT=production disables /metrics when unset).
#METRICS_TOKEN=
